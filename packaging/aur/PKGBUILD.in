# Maintainer: Aleksandr Oreshkin
pkgname=aeris
pkgver=@VERSION@
pkgrel=1
pkgdesc='Native desktop viewer for phone authenticator exports'
arch=('x86_64' 'aarch64')
url='https://github.com/Alex9001/Aeris'
license=('MIT')
depends=('qt6-base' 'qt6-keychain' 'openssl' 'libsodium' 'libzip' 'zxing-cpp' 'protobuf')
makedepends=('cmake' 'ninja')
optdepends=('qt6-wayland: Wayland platform integration')
source=("https://github.com/Alex9001/Aeris/releases/download/v${pkgver}/aeris-v${pkgver}-source.tar.gz")
sha256sums=('@SHA256@')
build() {
  cmake -S "aeris-${pkgver}" -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}
check() {
  QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure
}
package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "aeris-${pkgver}/LICENSE" "$pkgdir/usr/share/licenses/aeris/LICENSE"
}
